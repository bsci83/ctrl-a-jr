# Copy to .env.local (preferred, read first) or .env — both are gitignored.
# A value already exported in your shell beats both files.

# Stripe — TEST MODE ONLY. A live key is refused at startup.
STRIPE_SECRET_KEY=sk_test_...

# Gmail — a Google App Password, not your account password (requires 2FA).
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Slack — a bot token with chat:write.
SLACK_BOT_TOKEN=xoxb-...

# Inference. Primary is MiniMax via its Anthropic-compatible endpoint.
ANTHROPIC_API_KEY=...
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
CTRLA_JR_MODEL=MiniMax-M3

# Fallback, used only after an approved provider_switch.
OPENROUTER_API_KEY=
CTRLA_JR_FALLBACK_MODEL=anthropic/claude-sonnet-4

# Approval surface: "local" (default, the local page) or "remote" (the deployed
# API this agent pushes to and polls). Remote requires BOTH variables below —
# a missing one fails the run rather than quietly reverting to local.
# The agent still accepts no inbound connection either way.
CTRLA_JR_APPROVER=local
CTRLA_JR_APPROVAL_API=https://your-app.vercel.app
CTRLA_JR_PUSH_TOKEN=
